# Django Settings
SECRET_KEY=your-production-secret-key-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=yalla-zaker.onine,www.yalla-zaker.onine,.yalla-zaker.onine,yalla-zaker.online,www.yalla-zaker.online,.yalla-zaker.online,.vercel.app
CSRF_TRUSTED_ORIGINS=https://yalla-zaker.onine,https://www.yalla-zaker.onine,https://yalla-zaker.online,https://www.yalla-zaker.online

# Neon PostgreSQL (add in Vercel Project Settings -> Environment Variables)
# Set DATABASE_URL manually, OR connect Neon via the Vercel integration which
# provides POSTGRES_URL / POSTGRES_URL_NON_POOLING - settings.py reads any of these.
DATABASE_URL=postgresql://neondb_owner:your-password@ep-your-project-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require